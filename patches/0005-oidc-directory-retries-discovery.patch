+    /// An OIDC directory's discovery document, discovering it first when that has not
+    /// succeeded yet. `Some(Err)` while the identity provider cannot be reached, and for an
+    /// OIDC directory that could not be built at all.
+    pub async fn oidc_discovery_document(&self) -> Option<trc::Result<&OidcDiscovery>> {
+        match &self {
