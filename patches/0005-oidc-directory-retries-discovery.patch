+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, SystemTime},
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::TcpListener,
+    task::JoinHandle,
+};
+
+const RETRY_MIN: Duration = Duration::from_secs(2);
+const RETRY_MAX: Duration = Duration::from_secs(4);
+const EMAIL: &str = "alex.chen@example.org";
+const AUDIENCE: &str = "mail-test";
+
+#[derive(Clone, Copy, PartialEq)]
+enum Mode {
+    Serve,
+    Unavailable,
+}
+
+struct MockIdp {
+    requests: Arc<AtomicUsize>,
+    state: Arc<Mutex<(Mode, String)>>,
+    task: JoinHandle<()>,
+}
+
+impl MockIdp {
+    /// Serves on `addr`: the discovery document (whose issuer is `issuer`) and `jwks`.
+    async fn start(addr: SocketAddr, issuer: &str, jwks: Value, mode: Mode) -> Self {
+        let listener = TcpListener::bind(addr).await.expect("rebind the IdP port");
+        let requests = Arc::new(AtomicUsize::new(0));
+        let state = Arc::new(Mutex::new((mode, issuer.to_string())));
+        let base = format!("http://{addr}");
+        let task = {
+            let requests = requests.clone();
+            let state = state.clone();
+            tokio::spawn(async move {
+                loop {
+                    let Ok((mut stream, _)) = listener.accept().await else {
+                        return;
+                    };
+                    let requests = requests.clone();
+                    let state = state.clone();
+                    let base = base.clone();
+                    let jwks = jwks.clone();
+                    tokio::spawn(async move {
+                        let mut buf = Vec::new();
+                        let mut chunk = [0u8; 1024];
+                        while !buf.windows(4).any(|w| w == b"\r\n\r\n") {
+                            match stream.read(&mut chunk).await {
+                                Ok(0) | Err(_) => return,
+                                Ok(n) => buf.extend_from_slice(&chunk[..n]),
+                            }
+                        }
+                        requests.fetch_add(1, Ordering::SeqCst);
+                        let request = String::from_utf8_lossy(&buf);
+                        let path = request.split_whitespace().nth(1).unwrap_or_default();
+                        let (mode, issuer) = state.lock().unwrap().clone();
+                        let (status, body) = match (mode, path) {
+                            (Mode::Unavailable, _) => ("503 Service Unavailable", String::new()),
+                            (_, "/.well-known/openid-configuration") => (
+                                "200 OK",
+                                json!({
+                                    "issuer": issuer,
+                                    "jwks_uri": format!("{base}/jwks"),
+                                    "userinfo_endpoint": format!("{base}/userinfo"),
+                                    "token_endpoint": format!("{base}/token"),
+                                    "authorization_endpoint": format!("{base}/auth"),
+                                })
+                                .to_string(),
+                            ),
+                            (_, "/jwks") => ("200 OK", jwks.to_string()),
+                            _ => ("404 Not Found", String::new()),
+                        };
+                        let response = format!(
+                            "HTTP/1.1 {status}\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{body}",
+                            body.len()
+                        );
+                        let _ = stream.write_all(response.as_bytes()).await;
+                        let _ = stream.shutdown().await;
+                    });
+                }
+            })
+        };
+
+        MockIdp {
+            requests,
+            state,
+            task,
+        }
+    }
+
+    fn requests(&self) -> usize {
+        self.requests.load(Ordering::SeqCst)
+    }
+
+    fn set(&self, mode: Mode, issuer: &str) {
+        *self.state.lock().unwrap() = (mode, issuer.to_string());
+    }
+}
+
+impl Drop for MockIdp {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+/// A port nothing listens on: the identity provider is down.
+fn free_port() -> SocketAddr {
+    std::net::TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+}
+
+fn rsa_key() -> KeyPair {
+    KeyPair::generate(KeySize::Rsa2048).unwrap()
+}
+
+fn jwks(key: &KeyPair, kid: &str) -> Value {
+    let public = key.public_key();
+    json!({"keys": [{
+        "kty": "RSA",
+        "kid": kid,
+        "use": "sig",
+        "alg": "RS256",
+        "n": URL_SAFE_NO_PAD.encode(public.modulus().big_endian_without_leading_zero()),
+        "e": URL_SAFE_NO_PAD.encode(public.exponent().big_endian_without_leading_zero()),
+    }]})
+}
+
+fn claims(issuer: &str) -> Value {
+    let now = SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    json!({
+        "iss": issuer,
+        "aud": AUDIENCE,
+        "sub": "0d4c2f5e",
+        "email": EMAIL,
+        "name": "Alex Chen",
+        "iat": now,
+        "exp": now + 300,
+    })
+}
+
+fn sign(key: &KeyPair, kid: &str, claims: &Value) -> String {
+    let header = json!({"alg": "RS256", "typ": "JWT", "kid": kid});
+    let input = format!(
+        "{}.{}",
+        URL_SAFE_NO_PAD.encode(header.to_string()),
+        URL_SAFE_NO_PAD.encode(claims.to_string())
+    );
+    let mut signature = vec![0; key.public_modulus_len()];
+    key.sign(
+        &RSA_PKCS1_SHA256,
+        &SystemRandom::new(),
+        input.as_bytes(),
+        &mut signature,
+    )
+    .unwrap();
+    format!("{input}.{}", URL_SAFE_NO_PAD.encode(signature))
+}
+
+fn unsigned(claims: &Value) -> String {
+    format!(
+        "{}.{}.",
+        URL_SAFE_NO_PAD.encode(json!({"alg": "none", "typ": "JWT"}).to_string()),
+        URL_SAFE_NO_PAD.encode(claims.to_string())
+    )
+}
+
+async fn directory(issuer: &str) -> Directory {
+    Directory::OpenId(
+        OpenIdDirectory::with_retry(
+            OidcConfig {
+                issue_url: issuer.to_string(),
+                require_aud: Some(AUDIENCE.to_string()),
+                require_scopes: vec![],
+                claim_email: "email".to_string(),
+                claim_name: Some("name".to_string()),
+                claim_groups: None,
+                default_domain: None,
+            },
+            RETRY_MIN,
+            RETRY_MAX,
+        )
+        .await
+        .expect("a directory is built whether or not its provider answers"),
+    )
+}
+
+fn bearer(token: &str) -> Credentials {
+    Credentials::Bearer {
+        username: None,
+        token: token.to_string(),
+    }
+}
+
+/// Rejected as the provider being unavailable: an error, never a failed login (which fail2ban
+/// would count against the user's address) and never a success.
+async fn assert_unavailable(directory: &Directory, token: &str) {
+    let err = directory
+        .authenticate(&bearer(token))
+        .await
+        .expect_err("a token was accepted by an undiscovered directory");
+    assert!(
+        matches!(err.as_ref(), trc::EventType::Auth(trc::AuthEvent::Error)),
+        "{err:?}"
+    );
+    assert!(
+        format!("{err:?}").contains("Identity provider unavailable"),
+        "{err:?}"
+    );
+}
+
+#[tokio::test]
+async fn directory_built_while_the_idp_is_down_recovers_without_a_restart() {
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let key = rsa_key();
+    let token = sign(&key, "k1", &claims(&issuer));
+
+    // Built while nothing listens: upstream returned an error here and the directory was left
+    // out until a restart.
+    let directory = directory(&issuer).await;
+    assert_unavailable(&directory, &token).await;
+    assert!(matches!(
+        directory.oidc_discovery_document().await,
+        Some(Err(_))
+    ));
+    assert_eq!(directory.oidc_issuer_url(), Some(issuer.as_str()));
+
+    // The provider comes up. Within the backoff it is not asked, and the token still fails.
+    let idp = MockIdp::start(addr, &issuer, jwks(&key, "k1"), Mode::Serve).await;
+    assert_unavailable(&directory, &token).await;
+    assert_eq!(idp.requests(), 0, "asked the provider inside the backoff");
+
+    // After the backoff the next token rediscovers the provider and is verified.
+    tokio::time::sleep(RETRY_MIN + Duration::from_millis(300)).await;
+    let account = directory.authenticate(&bearer(&token)).await.unwrap();
+    assert_eq!(account.email, EMAIL);
+    assert_eq!(account.description.as_deref(), Some("Alex Chen"));
+    assert_eq!(idp.requests(), 2, "discovery document and JWKS");
+    let discovery = directory.oidc_discovery_document().await.unwrap().unwrap();
+    assert_eq!(discovery.document.issuer, issuer);
+
+    // Discovered, it behaves as upstream: the signature, the audience and the issuer are
+    // still checked, and a known key is not fetched again.
+    let forged = sign(&rsa_key(), "k1", &claims(&issuer));
+    let mut wrong_audience = claims(&issuer);
+    wrong_audience["aud"] = json!("another-client");
+    let mut wrong_issuer = claims(&issuer);
+    wrong_issuer["iss"] = json!("https://idp.example.net");
+    for token in [
+        forged,
+        sign(&key, "k1", &wrong_audience),
+        sign(&key, "k1", &wrong_issuer),
+        unsigned(&claims(&issuer)),
+    ] {
+        let err = directory.authenticate(&bearer(&token)).await.unwrap_err();
+        assert!(
+            !format!("{err:?}").contains("Identity provider unavailable"),
+            "{err:?}"
+        );
+    }
+    // The keys were not fetched again. The unsigned token is not a JWT the library accepts, so
+    // it went to the userinfo endpoint (upstream's opaque-token path), which refused it.
+    assert_eq!(idp.requests(), 3);
+}
+
+#[tokio::test]
+async fn an_undiscovered_directory_rejects_every_token() {
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let key = rsa_key();
+    let directory = directory(&issuer).await;
+
+    let tokens = [
+        sign(&key, "k1", &claims(&issuer)),
+        sign(&key, "unknown-kid", &claims(&issuer)),
+        unsigned(&claims(&issuer)),
+        "an-opaque-access-token".to_string(),
+    ];
+    for token in &tokens {
+        assert_unavailable(&directory, token).await;
+    }
+
+    // The retry after the backoff fails too, and so does every token after it.
+    tokio::time::sleep(RETRY_MIN + Duration::from_millis(300)).await;
+    for token in &tokens {
+        assert_unavailable(&directory, token).await;
+    }
+}
+
+#[tokio::test]
+async fn a_failing_provider_is_asked_once_per_backoff_however_many_tokens_arrive() {
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let key = rsa_key();
+    let idp = MockIdp::start(addr, &issuer, jwks(&key, "k1"), Mode::Unavailable).await;
+    let directory = Arc::new(directory(&issuer).await);
+    assert_eq!(idp.requests(), 1, "the attempt when the directory is built");
+
+    tokio::time::sleep(RETRY_MIN + Duration::from_millis(300)).await;
+    let token = sign(&key, "k1", &claims(&issuer));
+    let attempts = (0..25)
+        .map(|_| {
+            let directory = directory.clone();
+            let token = token.clone();
+            tokio::spawn(async move { directory.authenticate(&bearer(&token)).await })
+        })
+        .collect::<Vec<_>>();
+    for attempt in attempts {
+        assert!(attempt.await.unwrap().is_err());
+    }
+    assert_eq!(idp.requests(), 2, "one retry for 25 concurrent tokens");
+
+    // The provider recovers; the next attempt is after the doubled backoff, and succeeds.
+    idp.set(Mode::Serve, &issuer);
+    tokio::time::sleep(RETRY_MAX + Duration::from_millis(300)).await;
+    assert_eq!(
+        directory.authenticate(&bearer(&token)).await.unwrap().email,
+        EMAIL
+    );
+}
+
+#[tokio::test]
+async fn a_token_does_not_wait_for_an_attempt_in_flight() {
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let directory = Arc::new(directory(&issuer).await);
+    let token = sign(&rsa_key(), "k1", &claims(&issuer));
+
+    // The provider accepts connections and never answers.
+    let _blackhole = std::net::TcpListener::bind(addr).unwrap();
+    tokio::time::sleep(RETRY_MIN + Duration::from_millis(300)).await;
+    let stuck = {
+        let directory = directory.clone();
+        let token = token.clone();
+        tokio::spawn(async move { directory.authenticate(&bearer(&token)).await })
+    };
+    tokio::time::sleep(Duration::from_millis(300)).await;
+
+    let started = std::time::Instant::now();
+    assert_unavailable(&directory, &token).await;
+    assert!(
+        started.elapsed() < Duration::from_secs(1),
+        "waited for the attempt"
+    );
+    stuck.abort();
+}
+
+#[tokio::test]
+async fn a_document_for_another_issuer_is_rejected_and_retried() {
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let key = rsa_key();
+    let token = sign(&key, "k1", &claims(&issuer));
+    let idp = MockIdp::start(
+        addr,
+        "https://idp.example.net",
+        jwks(&key, "k1"),
+        Mode::Serve,
+    )
+    .await;
+    let directory = directory(&issuer).await;
+
+    let err = directory.authenticate(&bearer(&token)).await.unwrap_err();
+    assert!(format!("{err:?}").contains("Issuer mismatch"), "{err:?}");
+    assert_eq!(
+        idp.requests(),
+        1,
+        "no JWKS is fetched for a mismatched issuer"
+    );
+
+    // Fixing the provider needs no restart here.
+    idp.set(Mode::Serve, &issuer);
+    tokio::time::sleep(RETRY_MIN + Duration::from_millis(300)).await;
+    assert_eq!(
+        directory.authenticate(&bearer(&token)).await.unwrap().email,
+        EMAIL
+    );
+}
+
+#[tokio::test]
+async fn a_directory_is_built_without_waiting_for_its_provider() {
+    // Upstream retries discovery for 30 seconds inside open(), which holds up the server's start
+    // and every registry reload while the provider is down. Here it is one attempt, and the
+    // directory is built undiscovered: nothing listening, and a provider answering 503.
+    let started = std::time::Instant::now();
+    let down = directory(&format!("http://{}", free_port())).await;
+    assert!(
+        started.elapsed() < Duration::from_secs(2),
+        "building waited {:?} for a provider that is down",
+        started.elapsed()
+    );
+    assert!(matches!(down.oidc_discovery_document().await, Some(Err(_))));
+
+    let addr = free_port();
+    let issuer = format!("http://{addr}");
+    let idp = MockIdp::start(addr, &issuer, jwks(&rsa_key(), "k1"), Mode::Unavailable).await;
+    let started = std::time::Instant::now();
+    let failing = directory(&issuer).await;
+    assert!(
+        started.elapsed() < Duration::from_secs(2),
+        "building waited {:?} for a failing provider",
+        started.elapsed()
+    );
+    assert_eq!(idp.requests(), 1, "one attempt when the directory is built");
+    assert!(matches!(
+        failing.oidc_discovery_document().await,
+        Some(Err(_))
+    ));
+}
+
+#[tokio::test]
+async fn an_oidc_directory_that_could_not_be_built_has_no_discovery_document() {
+    // Never this server's own metadata for a domain that signs in through an identity provider.
+    let oidc = Directory::Unavailable(UnavailableDirectory::new(DirectoryType::Oidc, "failed"));
+    assert!(matches!(oidc.oidc_discovery_document().await, Some(Err(_))));
+    assert_eq!(oidc.oidc_issuer_url(), None);
+
+    let ldap = Directory::Unavailable(UnavailableDirectory::new(DirectoryType::Ldap, "failed"));
+    assert!(ldap.oidc_discovery_document().await.is_none());
+}
