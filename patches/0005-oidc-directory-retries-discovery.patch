+                    .discovered()
+                    .await
+                    .map(|discovered| &discovered.discovery)
+                    .map_err(|err| trc::AuthEvent::Error.into_err().reason(err)),
+            ),
+            Directory::Unavailable(directory)
+                if directory.directory_type() == DirectoryType::Oidc =>
+            {
+                Some(Err(directory.error()))
+            }
