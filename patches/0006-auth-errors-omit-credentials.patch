From e7afd037071233222557d83e7451901baf274d7e Mon Sep 17 00:00:00 2001
From: Klemens Arro <1125090+kempu@users.noreply.github.com>
Date: Thu, 19 Nov 2026 14:59:05 +0200
Subject: [PATCH 6/6] auth: an authentication error never carries the
 credential it rejected

An authentication error becomes an auth.error event, which is logged and
which the store tracer keeps. Several of them carried the credential:

- a Bearer token the internal decoder could not open, whole, in Details.
  That is every token from an external identity provider whose directory
  is unavailable, and every refresh token /auth/token failed to validate;
- an Authorization header with an unsupported scheme: all of it after
  the scheme;
- a Basic header that did not decode: the encoded credentials;
- a stored secret that could not be verified: the stored value, which
  for an LDAP or SQL directory that stores passwords so is the plaintext
  password, and otherwise its hash;
- a stored TOTP URI that did not parse: the URI, TOTP secret included.

Each now says what failed, without the value. No fingerprint takes the
token's place: the event already carries the session, the remote address
and, where known, the account, and a hash of a token would be a stable
identifier for a live bearer credential.

The trace-level raw protocol events (RawInput of IMAP, POP3, ManageSieve
and SMTP, and the HTTP response body) record what crosses the wire,
credentials and mail included, by design. They are off unless tracing is
set to trace, and are unchanged.
---
 crates/common/src/auth/oauth/token.rs | 60 +++++++++++++++++++++++----
 crates/directory/src/core/secret.rs   | 45 +++++++++++++++++---
 crates/http/src/auth/authenticate.rs  |  2 -
 3 files changed, 92 insertions(+), 15 deletions(-)

diff --git a/crates/common/src/auth/oauth/token.rs b/crates/common/src/auth/oauth/token.rs
index cc4ef4f..f99858b 100644
--- a/crates/common/src/auth/oauth/token.rs
+++ b/crates/common/src/auth/oauth/token.rs
@@ -78,15 +78,9 @@ impl Server {
     pub async fn validate_access_token(
         &self,
         expected_grant_type: Option<GrantType>,
-        token_: &str,
+        token: &str,
     ) -> trc::Result<TokenInfo> {
-        let token = open_token(self.core.oauth.oauth_key.as_bytes(), token_).map_err(|_| {
-            trc::AuthEvent::Error
-                .into_err()
-                .ctx(trc::Key::Reason, FAILED_TO_DECODE_TOKEN)
-                .caused_by(trc::location!())
-                .details(token_.to_string())
-        })?;
+        let token = decode_access_token(self.core.oauth.oauth_key.as_bytes(), token)?;
 
         // Validate expiration
         let now = seconds_since_oauth_epoch();
@@ -126,6 +120,17 @@ impl Server {
     }
 }
 
+/// Opens a token this server issued. The error never carries the token: it is a bearer
+/// credential, and the error becomes an auth.error event that is logged and can be stored.
+fn decode_access_token(key: &[u8], token: &str) -> trc::Result<RawToken> {
+    open_token(key, token).map_err(|_| {
+        trc::AuthEvent::Error
+            .into_err()
+            .ctx(trc::Key::Reason, FAILED_TO_DECODE_TOKEN)
+            .caused_by(trc::location!())
+    })
+}
+
 fn seal_token(key: &[u8], token: &RawToken, footer: &[u8]) -> Result<String, String> {
     let mut payload = Vec::with_capacity(32);
     payload.push_leb128(token.account_id);
@@ -415,4 +420,43 @@ mod tests {
         let opened = open_token(KEY, &token).unwrap();
         assert_eq!(opened.claims.as_deref(), Some("a;b;c;d@e.org;999"));
     }
+
+    // A token that does not decode becomes an auth.error event, which is logged and can be
+    // stored. It is a bearer credential (or, for an OIDC directory that is down, the user's
+    // valid IdP token), so the event names the failure and never carries the token.
+    #[test]
+    fn undecodable_token_is_not_in_the_error() {
+        let issued = seal_token(KEY, &sample(GrantType::AccessToken, None, 0), NAME).unwrap();
+        let jwt = "eyJhbGciOiJSUzI1NiIsImtpZCI6ImsxIn0.eyJzdWIiOiJ4In0.c2lnbmF0dXJl";
+
+        for token in [
+            jwt,
+            issued.as_str(),
+            "sw1.not-base64!",
+            "opaque-bearer-value",
+        ] {
+            let key: &[u8] = if token == issued {
+                b"a-different-encryption-key-entirely!"
+            } else {
+                KEY
+            };
+            let err = match decode_access_token(key, token) {
+                Err(err) => err,
+                Ok(_) => panic!("{token} decoded"),
+            };
+            assert!(matches!(
+                err.as_ref(),
+                trc::EventType::Auth(trc::AuthEvent::Error)
+            ));
+            assert_eq!(
+                err.value(trc::Key::Reason).and_then(|v| v.as_str()),
+                Some(FAILED_TO_DECODE_TOKEN)
+            );
+            let logged = format!("{err:?}");
+            assert!(
+                !logged.contains(token),
+                "the error carries the token: {logged}"
+            );
+        }
+    }
 }
diff --git a/crates/directory/src/core/secret.rs b/crates/directory/src/core/secret.rs
index f0d2c8f..debdc42 100644
--- a/crates/directory/src/core/secret.rs
+++ b/crates/directory/src/core/secret.rs
@@ -39,9 +39,10 @@ pub async fn verify_mfa_secret_hash(
             let result = verify_secret_hash(hashed_secret, secret.as_bytes()).await?
                 && Totp::from_url(totp_uri)
                     .map_err(|err| {
+                        // Never the URI itself: it carries the TOTP shared secret.
                         trc::AuthEvent::Error
                             .reason(err)
-                            .details(totp_uri.to_string())
+                            .details("Stored TOTP URI could not be parsed")
                     })?
                     .check_current(totp_token)
                     .is_some();
@@ -97,7 +98,7 @@ async fn verify_hash_prefix(hashed_secret: &str, secret: &[u8]) -> trc::Result<b
             Err(err) => {
                 tx.send(Err(trc::AuthEvent::Error
                     .reason(err)
-                    .details(hashed_secret)))
+                    .details("Stored password hash could not be parsed")))
                     .ok();
             }
         });
@@ -126,10 +127,12 @@ async fn verify_hash_prefix(hashed_secret: &str, secret: &[u8]) -> trc::Result<b
     } else {
         Err(trc::AuthEvent::Error
             .into_err()
-            .details(hashed_secret.to_string()))
+            .details("Stored secret has an unrecognised hash format"))
     }
 }
 
+// An error from here never carries the stored secret. It is a password hash, or for a directory
+// that stores them so a plaintext password, and the error becomes a logged auth.error event.
 pub async fn verify_secret_hash(hashed_secret: &str, secret: &[u8]) -> trc::Result<bool> {
     if hashed_secret.starts_with('$') {
         verify_hash_prefix(hashed_secret, secret).await
@@ -228,12 +231,12 @@ pub async fn verify_secret_hash(hashed_secret: &str, secret: &[u8]) -> trc::Resu
                 "PLAIN" | "CLEAR" => Ok(hashed_secret.as_bytes() == secret),
                 _ => Err(trc::AuthEvent::Error
                     .ctx(trc::Key::Reason, "Unsupported algorithm")
-                    .details(hashed_secret.to_string())),
+                    .details("Stored secret uses an unsupported scheme")),
             }
         } else {
             Err(trc::AuthEvent::Error
                 .into_err()
-                .details(hashed_secret.to_string()))
+                .details("Stored secret has an unrecognised hash format"))
         }
     } else if !hashed_secret.is_empty() {
         Ok(hashed_secret.as_bytes() == secret)
@@ -644,4 +647,36 @@ mod tests {
             assert!(!is_password_hash(p), "false positive: {p:?}");
         }
     }
+
+    // A stored secret that cannot be verified is reported without itself: for a directory that
+    // stores them so, it is a plaintext password, and the error is logged as auth.error.
+    #[tokio::test]
+    async fn errors_never_carry_the_stored_secret() {
+        for stored in [
+            "$not-a-known-hash-scheme-p4ssw0rd",
+            "$argon2id$malformed-p4ssw0rd",
+            "{unclosed-p4ssw0rd",
+            "{p4ssw0rd}scheme-is-the-password",
+        ] {
+            let err = verify_secret_hash(stored, b"attempt")
+                .await
+                .expect_err(stored);
+            let logged = format!("{err:?}");
+            assert!(
+                !logged.contains("p4ssw0rd"),
+                "the error for {stored:?} carries it: {logged}"
+            );
+        }
+
+        let totp_uri =
+            "otpauth://totp/Example:alex.chen@example.org?secret=JBSWY3DPEHPK3PXP&digits=5";
+        let err = verify_mfa_secret_hash(Some(totp_uri), Some("123456"), "pw", "pw")
+            .await
+            .expect_err("a malformed TOTP URI is an error");
+        let logged = format!("{err:?}");
+        assert!(
+            !logged.contains("JBSWY3DPEHPK3PXP"),
+            "the error carries the TOTP secret: {logged}"
+        );
+    }
 }
