+                    && object.keys().all(|key| {
+                        matches!(key, Key::Property(CalendarProperty::IsSubscribed | CalendarProperty::Id))
+                    })
+            });
+
             // Apply changes
             let has_acl_changes = match update_calendar(
                 Some(id),
@@ -196,7 +209,22 @@ impl CalendarSet for Server {
             // Validate ACL
             if is_shared {
                 let acl = calendar.inner.acls.effective_acl(access_token);
-                if !acl.contains(Acl::Modify) || (has_acl_changes && !acl.contains(Acl::Share)) {
+                if subscription_only {
+                    // A sharee's own id, never the owner's: the change must not reach anyone
+                    // else's subscription.
+                    if !acl.contains(Acl::Read)
+                        || access_token.personal_id(account_id, Collection::Calendar) == account_id
+                    {
+                        response.not_updated.append(
+                            id,
+                            SetError::forbidden()
+                                .with_description("You are not allowed to access this calendar."),
+                        );
+                        continue 'update;
+                    }
+                } else if !acl.contains(Acl::Modify)
+                    || (has_acl_changes && !acl.contains(Acl::Share))
