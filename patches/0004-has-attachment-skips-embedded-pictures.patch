 pub(super) const MAX_MESSAGE_PARTS: usize = 1000;
 pub const PREVIEW_LENGTH: usize = 256;
 
+/// Whether a message has a part a client should offer as a download: JMAP's `hasAttachment`.
+/// Ingest stores the answer and Email/parse computes it, and both ask here.
+///
+/// A text or HTML part counts when it is not part of the body, and an attached message always
+/// counts. Any other part counts unless it is a picture the HTML body shows: a part with a
+/// Content-ID, not marked `attachment`, that the HTML refers to as `cid:` (RFC 8621 lets a server
+/// leave out "embedded images in one of the text/html parts"). mail-parser never lists such a
+/// part in html_body: inside a multipart/related only the first part is inline, so a signature
+/// logo next to the HTML is a Binary part, exactly as an attachment is.
+pub fn has_attachments(message: &Message<'_>) -> bool {
+    let mut html_cids = None;
+
+    message
+        .parts
+        .iter()
+        .take(MAX_MESSAGE_PARTS)
+        .enumerate()
+        .any(|(part_id, part)| {
+            let part_id = part_id as u32;
+            match &part.body {
+                PartType::Text(_) | PartType::Html(_) => {
+                    !message.text_body.contains(&part_id) && !message.html_body.contains(&part_id)
+                }
+                PartType::Binary(_) => {
+                    part.content_disposition()
+                        .is_some_and(|disposition| disposition.is_attachment())
+                        || part.content_id().is_none_or(|cid| {
+                            !html_cids
+                                .get_or_insert_with(|| html_body_cids(message))
+                                .contains(&cid.to_ascii_lowercase())
+                        })
+                }
+                PartType::Message(_) => true,
+                PartType::InlineBinary(_) | PartType::Multipart(_) => false,
+            }
+        })
+}
+
+/// The Content-IDs the HTML body refers to as `cid:` URLs, lowercased. One pass over the HTML,
+/// however many parts ask.
+fn html_body_cids(message: &Message<'_>) -> AHashSet<String> {
+    let mut cids = AHashSet::new();
+    for part_id in &message.html_body {
+        if let Some(PartType::Html(html)) = message.parts.get(*part_id as usize).map(|p| &p.body) {
+            let html = html.to_ascii_lowercase();
+            for (pos, _) in html.match_indices("cid:") {
+                let cid = html[pos + 4..]
+                    .split(|c: char| {
+                        c.is_ascii_whitespace()
+                            || matches!(c, '"' | '\'' | ')' | '>' | '&' | ',' | ';')
+                    })
+                    .next()
+                    .unwrap_or_default();
+                if !cid.is_empty() {
+                    cids.insert(cid.to_string());
+                }
+            }
+        }
+    }
+    cids
+}
